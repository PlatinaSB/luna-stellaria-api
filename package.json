{
	"name": "luna-stellaria-api",
	"version": "0.0.1",
	"description": "backend api layer for luna-stellaria",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"gen": "wrangler types",
		"build": "npm run gen && npm run typecheck",
		"deploy": "npm run gen && npm run format && npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"prettier": "3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"express": "^5.3.0",
		"jose": "^6.2.12"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261012.1": true
	}
}
